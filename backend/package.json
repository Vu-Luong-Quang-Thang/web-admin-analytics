{
  "name": "web-admin-analytics-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env build/src/migrate.js && node --env-file-if-exists=.env build/src/server.js",
    "dev": "tsx --env-file=.env watch src/server.ts",
    "grant-admin": "node --env-file-if-exists=.env build/src/grant-admin.js",
    "create-local-admin": "node --env-file-if-exists=.env build/src/create-local-admin.js",
    "link-trooi-user": "node --env-file-if-exists=.env build/src/link-trooi-user.js",
    "test": "tsx --test test/**/*.test.ts",
    "test:integration": "tsx --test test/**/*.integration.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "google-auth-library": "^11.3.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
